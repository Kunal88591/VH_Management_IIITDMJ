## 🖥️ SERVER CONFIGURATION
PORT=5000
NODE_ENV=production

## 🗄️ DATABASE CONFIGURATION
# MongoDB Atlas Connection String
# Get yours from: https://cloud.mongodb.com
# 1. Create free cluster
# 2. Create database user
# 3. Whitelist IP (0.0.0.0/0 for all)
# 4. Get connection string
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/vh_management?retryWrites=true&w=majority

## 🔐 JWT AUTHENTICATION
JWT_SECRET=your_super_secret_jwt_key_change_this_to_random_string_min_32_chars
JWT_EXPIRE=7d

## 📧 EMAIL SERVICE CONFIGURATION (GMAIL)
# 1. Create Gmail account for VH System
# 2. Enable 2-Step Verification
# 3. Generate App Password from: https://myaccount.google.com/apppasswords
# 4. Use the 16-digit app password below (NOT regular Gmail password)
EMAIL_USER=vh-system@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=noreply@vh.iiitdmj.ac.in
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

## 🔗 CLIENT URL CONFIGURATION
# For deployment on IIITDMJ server:
CLIENT_URL=http://172.27.16.37
FRONTEND_URL=http://172.27.16.37

## ⚙️ OPTIONAL CONFIGURATIONS
# Override email host if using different SMTP provider
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
